# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods / Carthage (if ever used)
Pods/
Carthage/Build/

# Secrets / local config
*.env
Secrets.plist

# Local code-signing identity. Signing.xcconfig #include?s this file, so its
# absence is not an error -- see that file for what to put in it.
Local.xcconfig

# Local agent / tooling state
.claude-flow/
.claude/

# Swift package build products
.build/
.swiftpm/

# Evaluation runs (raw results are large and machine-specific)
eval-*.jsonl
*.graded.jsonl
# ...except the published ones. A number in a document here is generated from
# the records beside it and check.sh diffs the two, so the records have to be in
# the repository or the check passes locally and fails everywhere else.
!docs/eval-records/**/*.graded.jsonl

# Fine-tune build products (adapters and fused models are regenerated, not shared)
tools/finetune/adapters/

# Generated status page (regenerate with tools/status/status.sh --html)
docs/run-status.html
tools/finetune/adapters-525/*.safetensors

# Internal handover, kept outside the repo (names a key id and a local security note)
docs/HANDOVER.md

# The graded evaluation records are the evidence for docs/evaluation-local.md,
# so they are tracked despite the patterns above.
!docs/eval-records/*.jsonl

# swift test transcript, captured by CI
test.log

# The 225 arm keeps its config and its provenance, not its weights.
tools/finetune/adapters-225/*.safetensors
