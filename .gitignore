# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods / Carthage (if ever used)
Pods/
Carthage/Build/

# Secrets / local config
*.env
Secrets.plist

# Local agent / tooling state
.claude-flow/
.claude/

# Swift package build products
.build/
.swiftpm/

# Evaluation runs (raw results are large and machine-specific)
eval-*.jsonl
*.graded.jsonl

# Fine-tune build products (adapters and fused models are regenerated, not shared)
tools/finetune/adapters/

# Generated status page (regenerate with tools/status/status.sh --html)
docs/run-status.html
tools/finetune/adapters-525/*.safetensors

# Internal handover, kept outside the repo (names a key id and a local security note)
docs/HANDOVER.md

# The graded evaluation records are the evidence for docs/evaluation-local.md,
# so they are tracked despite the patterns above.
!docs/eval-records/*.jsonl

# swift test transcript, captured by CI
test.log
